# =============================================================================
# Trading System v2 — environment template
# Copy to .env and fill in your secrets. Never commit .env.
# =============================================================================

# --- Alpaca (paper) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_FEED=iex

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alternative data (Phase 4) ---
QUIVER_API_TOKEN=

# --- News intelligence (Phase 5) ---
ANTHROPIC_API_KEY=
ALPHAVANTAGE_API_KEY=

# --- Trading ---
INITIAL_CAPITAL=5000
ENABLE_TRADING=true

# --- Feature flags ---
ENABLE_CROWDING_DETECTION=true
ENABLE_ANTI_HERDING=true
ENABLE_REGIME_DETECTION=true
ENABLE_MICROSTRUCTURE=true
ENABLE_ALTERNATIVE_DATA=false
ENABLE_NEWS_INTELLIGENCE=false
ENABLE_DATABASE=true

# --- Database ---
DB_TYPE=sqlite
DB_PATH=data/trading.db

# --- Logging ---
LOG_LEVEL=INFO
DEBUG_MODE=false

# --- Hardening ---
STRICT_CONFIG=false
